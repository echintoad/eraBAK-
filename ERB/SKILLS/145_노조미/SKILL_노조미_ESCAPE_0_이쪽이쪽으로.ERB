#DIM 대상부대

#DIM 도시번호
#LOCALSIZE 2
대상측 = !발동측

; 도시번호 검색
IF 발동부대 == -1
	도시번호 = 발동세력
ELSE
	도시번호 = UNIT_POSITION:발동세력:발동부대
ENDIF

; 포박율 감소 계산 (0 ~ 350), 도시 경제 171 = 50, 1200 = 350
LOCAL:1 = MIN(CITY_ECONOMY:도시번호 / 342, 350)
FOR LOCAL, 0, BATTLE_COMMANDER_NUM:발동측
	SIF BATTLE_SUMMONED_CHARA:발동측:LOCAL
		CONTINUE
    CAPTURE_RATE:LOCAL = MIN_DECREASE(CAPTURE_RATE:LOCAL, LOCAL:1, 0)
NEXT

