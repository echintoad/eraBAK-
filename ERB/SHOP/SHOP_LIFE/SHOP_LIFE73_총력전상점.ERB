		PRINTBUTTON  @"[%"구입", MAX_CHARANAME_LENGTH, LEFT%]",총력전장비 + 1000
	ELSE 
		SETCOLOR 칼라_선택불가
		PRINTFORM [%"구입", MAX_CHARANAME_LENGTH, LEFT%]
		RESETCOLOR
	ENDIF
ENDIF
PRINTPLAIN  
PRINTBUTTON @"[%"돌아온다", MAX_CHARANAME_LENGTH, LEFT%]", 999
PRINTL 

REDRAW 0

$INPUT_LOOP
INPUT 999

IF RESULT == 999
	IF 상점단계 > 0
		CLEARLINE LINECOUNT - FIRST_LINE_ITEM_MAIN
		상점단계 --
		캐릭터선택 = 0
		캐릭터선택장비선택 = 0
		장비선택 = 0
		GOTO 상점루프
	ENDIF
	REDRAW 1
	RETURN
ELSEIF RESULT == 1 || RESULT == 2 || RESULT == 3 && 상점단계 == 0
	CLEARLINE LINECOUNT - FIRST_LINE_ITEM_MAIN
	첫번째 = RESULT
	상점단계 = 1
	GOTO 상점루프
ELSEIF RESULT == 11 || RESULT == 12 || RESULT == 13 || RESULT == 31 || RESULT == 32 && 상점단계 == 1
	CLEARLINE LINECOUNT - FIRST_LINE_ITEM_MAIN
	두번째 = RESULT
	상점단계 = 2
	GOTO 상점루프
ELSEIF RESULT >= 20 && RESULT <= 28 && 상점단계 == 2
	CLEARLINE LINECOUNT - FIRST_LINE_ITEM_MAIN
	총력전장비 = RESULT - 20 
	상점단계 = 3
	GOTO 상점루프
ELSEIF RESULT == 총력전장비 + 1000 && 상점단계 == 3
	CLEARLINE 1
	SETCOLOR 칼라_선택불가
	CALL SINGLE_DRAWLINE
	RESETCOLOR
	CALL 장비이름(총력전장비)
	PRINTFORML [%RESULTS%] 구매 하시겠습니까?
	CALL ASK_YN
	IF RESULT == 0
		ITEM:155 -= 5
		장비:총력전장비 ++
	ELSE 
		GOTO 상점루프
	ENDIF
ELSEIF RESULT >= 2000 && RESULT <= 2072 && 상점단계 == 2
	CLEARLINE 1
	IF 장비:(RESULT - 2000) > 0
		CLEARLINE LINECOUNT - FIRST_LINE_ITEM_MAIN
		총력전장비 = RESULT - 2000
		장비선택 = 1
		GOTO 상점루프
	ELSE
		PRINTW 유효하지 않은 입력입니다.
	ENDIF
ELSEIF RESULT >= 3000 && RESULT < 4000 && 상점단계 == 2
	CLEARLINE LINECOUNT - FIRST_LINE_ITEM_MAIN
	캐릭터선택 = 1
	캐릭터선택장비선택 = 0
	장비강화캐릭터선택 = RESULT - 3000
	GOTO 상점루프
ELSEIF RESULT == 4000 || RESULT == 4001 || RESULT == 4002 && 상점단계 == 2
	CLEARLINE LINECOUNT - FIRST_LINE_ITEM_MAIN
	IF 착용장비:장비강화캐릭터선택:(RESULT - 4000) >= 69
		PRINTW 이미 최대로 강화된 장비입니다
		GOTO 상점루프
	ELSEIF 착용장비:장비강화캐릭터선택:(RESULT - 4000) >= 0
		캐릭터선택 = 0
		캐릭터선택장비슬롯 = RESULT - 4000
		캐릭터선택장비선택 = 1
		캐릭터선택장비 = 착용장비:장비강화캐릭터선택:캐릭터선택장비슬롯
	ENDIF
	GOTO 상점루프
ELSEIF RESULT >= 5000 && RESULT < 6000 && 상점단계 == 2 && 캐릭터선택장비선택 == 1
	CLEARLINE 1
	SETCOLOR 칼라_선택불가
	CALL SINGLE_DRAWLINE
	RESETCOLOR
	CALL 장비이름(캐릭터선택장비)
	PRINTFORML [%RESULTS%]%조사만처리(RESULTS, "을")% 강화 하시겠습니까?
	PRINT 강화 비용: 
	IF 강회비용코인(캐릭터선택장비) > 0
		SETCOLOR 칼라_주의
		PRINTFORM {강회비용코인(캐릭터선택장비)} 
		PRINT Coin   
		RESETCOLOR
	ENDIF
	IF 강회비용상급코인(캐릭터선택장비) > 0 
		SETCOLOR 0Xc14fc9
		PRINTFORM {강회비용상급코인(캐릭터선택장비)} 
		PRINT Coin   
		RESETCOLOR
	ENDIF
	IF 강화비용크레딧(캐릭터선택장비) > 0
		PRINTFORM {강화비용크레딧(캐릭터선택장비)} 
		PRINT 크레딧
	ENDIF
	PRINTL
	PRINTL
	CALL ASK_YN
	IF RESULT == 0
		CLEARLINE 1
		ITEM:155 -= 강회비용코인(캐릭터선택장비)
		ITEM:156 -= 강회비용상급코인(캐릭터선택장비)
		MONEY -= 강화비용크레딧(캐릭터선택장비)
		CALL 총력전_장비_착용(장비강화캐릭터선택,캐릭터선택장비,캐릭터선택장비슬롯,-1)
		장비:캐릭터선택장비 --
		장비:(캐릭터선택장비+9) ++
		CALL 총력전_장비_착용(장비강화캐릭터선택,캐릭터선택장비+9,캐릭터선택장비슬롯,1)
		CALL 장비이름(캐릭터선택장비)
		LOCALS:0 = %RESULTS%
		CALL 장비이름(캐릭터선택장비 + 9)
		LOCALS:1 = %RESULTS%
		PRINTFORMW [%LOCALS:0%]%조사만처리(LOCALS:0,"이")% [%LOCALS:1%]%조사만처리(LOCALS:1,"로")% 강화되었습니다
	ELSE 
		캐릭터선택장비선택 = 0
		CLEARLINE LINECOUNT - FIRST_LINE_ITEM_MAIN
		GOTO 상점루프
	ENDIF
ELSEIF RESULT >= 6000 && RESULT < 7000 && 상점단계 == 2 && 장비선택 == 1
	CLEARLINE 1
	SETCOLOR 칼라_선택불가
	CALL SINGLE_DRAWLINE
	RESETCOLOR
	CALL 장비이름(총력전장비)
	PRINTFORML [%RESULTS%]%조사만처리(RESULTS, "을")% 강화 하시겠습니까?
	PRINT 강화 비용: 
	IF 강회비용코인(총력전장비) > 0
		SETCOLOR 칼라_주의
		PRINTFORM {강회비용코인(총력전장비)} 
		PRINT Coin   
		RESETCOLOR
	ENDIF
	IF 강회비용상급코인(총력전장비) > 0 
		SETCOLOR 0Xc14fc9
		PRINTFORM {강회비용상급코인(총력전장비)} 
		PRINT Coin   
		RESETCOLOR
	ENDIF
	IF 강화비용크레딧(총력전장비) > 0
		PRINTFORM {강화비용크레딧(총력전장비)} 
		PRINT 크레딧
	ENDIF
	PRINTL
	PRINTL
	CALL ASK_YN
	IF RESULT == 0
		CLEARLINE 1
		ITEM:155 -= 강회비용코인(총력전장비)
		ITEM:156 -= 강회비용상급코인(총력전장비)
		MONEY -= 강화비용크레딧(총력전장비)
		장비:총력전장비 --
		장비:(총력전장비+9) ++
		CALL 장비이름(총력전장비)
		LOCALS:0 = %RESULTS%
		CALL 장비이름(총력전장비 + 9)
		LOCALS:1 = %RESULTS%
		PRINTFORMW [%LOCALS:0%]%조사만처리(LOCALS:0, "이")% [%LOCALS:1%]%조사만처리(LOCALS:1, "로")% 강화되었습니다
	ELSE 
		장비선택 = 0
		CLEARLINE LINECOUNT - FIRST_LINE_ITEM_MAIN
		GOTO 상점루프
	ENDIF
ELSEIF RESULT == 7001 && ITEM:156 >= 1 && 상점단계 == 1
	CLEARLINE 1
	PRINTL 「총력전 코인×4」을 「상급 총력전 코인」으로 구매 하시겠습니까?
	CALL ASK_YN
	IF RESULT == 0
		ITEM:156 -= 1
		ITEM:155 += 4
	ELSE
		CLEARLINE LINECOUNT - FIRST_LINE_ITEM_MAIN
		GOTO 상점루프
	ENDIF
ELSEIF RESULT == 7002 && ITEM:155 >= 5 && 상점단계 == 1
	CLEARLINE 1
	PRINTL 「상급 총력전 코인」을 「총력전 코인×5」으로 구매 하시겠습니까?
	CALL ASK_YN
	IF RESULT == 0
		ITEM:155 -= 5
		ITEM:156 += 1
	ELSE
		CLEARLINE LINECOUNT - FIRST_LINE_ITEM_MAIN
		GOTO 상점루프
	ENDIF
ELSE
	REUSELASTLINE 
	REDRAW 2
	GOTO INPUT_LOOP
ENDIF

