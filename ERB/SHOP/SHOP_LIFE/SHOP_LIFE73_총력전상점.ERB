			PRINTFORM %TOSTR_SPACE(6)%보유중인 코인: 
			RESETCOLOR
		ENDIF
		LOCALS:0 = %ITEMNAME:(LOCAL:0)%
		IF ITEM:(LOCAL:0) >= 2
			LOCALS:0 = %LOCALS:0%×{ITEM:(LOCAL:0)}
		ENDIF
		LOCALS:0 = %LOCALS:0, 18, LEFT%
		LOCAL:1 += STRLENS(LOCALS:0) + 2
