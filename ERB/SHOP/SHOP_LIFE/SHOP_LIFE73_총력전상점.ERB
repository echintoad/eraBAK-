;region 기타 재료
; 기타 재료, 코인 교환
@SHOP_RAID_COIN_INPUT(코인타입)
#DIM 코인타입 ; 0=기본 코인, 1=상급 코인
#DIM DYNAMIC 코인소비
#DIM DYNAMIC 코인소비칼라
#DIM DYNAMIC 코인소비양
#DIM DYNAMIC 코인획득
#DIM DYNAMIC 코인획득칼라
#DIM DYNAMIC 코인획득양
#DIM DYNAMIC 교환최대
#DIM DYNAMIC FIRST_LINE
#LOCALSIZE 1
; #LOCALSSIZE 1
FIRST_LINE = LINECOUNT
; validate
코인타입 = LIMIT(코인타입, 0, 1)
CALL SINGLE_DRAWLINE
; item.csv 155,총력전 코인 | 156,상급 총력전 코인
SETCOLOR 칼라_주의
IF 코인타입 == 0 ; 상급 -> 코인
	교환최대 = ITEM:156
	PRINTL 교환:「총력전 코인×5」->「상급 총력전 코인」
ELSE ; ELSEIF 코인타입 == 1 ; 코인 -> 상급
	교환최대 = ITEM:155 / 5
	PRINTL 교환:「상급 총력전 코인」->「총력전 코인×4」
ENDIF
RESETCOLOR
PRINTFORML 교환 횟수 입력
SETCOLOR 칼라_회색
CALL SINGLE_DRAWLINE
RESETCOLOR
; 프리셋 버튼
IF 코인타입 == 0
	코인소비 = 156
	코인소비칼라 = 0xC14FC9
	코인소비양 = 1
	코인획득 = 155
	코인획득칼라 = 칼라_주의
	코인획득양 = 4
ELSE ; 코인타입 == 1
	코인소비 = 155
	코인소비칼라 = 칼라_주의
	코인소비양 = 5
	코인획득 = 156
	코인획득칼라 = 0xC14FC9
	코인획득양 = 1
ENDIF
FOR LOCAL, 0, MIN(5, 교환최대) ; 1 ~ 5
	; %ITEMNAME:(155)%x{LOCAL + 1} 소비
	PRINTBUTTON @"[%@"{LOCAL + 1}", 3, RIGHT%]", LOCAL + 1
	SETCOLOR 코인소비칼라
	PRINTFORM %TOSTR_SPACE(1)%%ITEMNAME:(코인소비)%%@"x{(LOCAL + 1) * 코인소비양}", 5, RIGHT% 소비
	SETCOLOR 코인획득칼라
	PRINTFORML %TOSTR_SPACE(3)%%ITEMNAME:(코인획득)%%@"x{(LOCAL + 1) * 코인획득양}", 5, RIGHT% 획득
	RESETCOLOR
NEXT
FOR LOCAL, 1, 10 ; 10 ~ 100
	IF LOCAL * 10 <= 교환최대
		PRINTBUTTON @"[%@"{LOCAL * 10}", 3, RIGHT%]", LOCAL * 10
		SETCOLOR 코인소비칼라
		PRINTFORM %TOSTR_SPACE(1)%%ITEMNAME:(코인소비)%%@"x{(LOCAL * 10) * 코인소비양}", 5, RIGHT% 소비
		SETCOLOR 코인획득칼라
		PRINTFORML %TOSTR_SPACE(3)%%ITEMNAME:(코인획득)%%@"x{(LOCAL * 10) * 코인획득양}", 5, RIGHT% 획득
		RESETCOLOR
	ELSE
		BREAK
	ENDIF
NEXT
; 모두 교환, 최대 999
IF 교환최대 > 5 && 교환최대 % 10 > 0
	LOCAL = MIN(교환최대, 999)
	PRINTBUTTON @"[%@"{LOCAL}", 3, RIGHT%]", LOCAL
	SETCOLOR 코인소비칼라
	PRINTFORM %TOSTR_SPACE(1)%%ITEMNAME:(코인소비)%%@"x{LOCAL * 코인소비양}", 5, RIGHT% 소비
	SETCOLOR 코인획득칼라
	PRINTFORML %TOSTR_SPACE(3)%%ITEMNAME:(코인획득)%%@"x{LOCAL * 코인획득양}", 5, RIGHT% 획득
	RESETCOLOR
ENDIF
; 취소 버튼
SETCOLOR 칼라_회색
CALL SINGLE_DRAWLINE
RESETCOLOR
PRINTBUTTON @"[%"취소", 6, RIGHT%]", 0
INPUT
; 코인 교환
IF RESULT > 0 && 코인타입 == 0 && RESULT <= 교환최대 ; 상급 -> 코인
	LOCAL = RESULT
	PRINTFORML %ITEMNAME:(코인소비)% {LOCAL}을 소비해, %ITEMNAME:(코인획득)% {LOCAL * 4}을 얻습니다
	PRINTFORML 좋습니까?
	CALL ASK_YN()
	IF RESULT == 1
		CLEARLINE LINECOUNT - FIRST_LINE
		RESTART
	ELSE
		ITEM:155 += LOCAL * 4
		ITEM:156 -= LOCAL
	ENDIF
ELSEIF RESULT > 0 && 코인타입 == 1 && RESULT <= 교환최대 ; 코인 -> 상급
	LOCAL = RESULT
	PRINTFORML %ITEMNAME:(코인소비)% {LOCAL * 5} 소비해, %ITEMNAME:(코인획득)% {LOCAL} 얻습니다
	PRINTFORML 좋습니까?
	CALL ASK_YN()
	IF RESULT == 1
		CLEARLINE LINECOUNT - FIRST_LINE
		RESTART
	ELSE
		ITEM:155 -= LOCAL * 5
		ITEM:156 += LOCAL
	ENDIF
ENDIF
RETURN 0

; 구 코드
@총력전상점
