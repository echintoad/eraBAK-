; #region == 총력전 ==
@총력전_스킬_1913_코스트(시전자)
#DIM 시전자 ; 코스트 당 대미지 스킬 카운터 위해서
; #DIM 가변
RETURN 3

@총력전_스킬_1913_설명(시전자)
#DIM 시전자 ; 가변스킬 설명 위해서
RESULTS = 1범위 적에게 대미지 (보호막에 공격력 100％, 이후 97％x2)

@총력전_스킬_1913_발동(시전자)
#DIM 시전자

#DIM DYNAMIC 주목표 ; 목표
#DIM DYNAMIC 목표, 총력전_캐릭터수 ; 목표 + 주변 적
#DIM DYNAMIC 대미지
#DIM DYNAMIC iTmp, 2
#DIMS DYNAMIC sTmp

; 발동 텍스트
CALL SKILL_1913_SP_0_NAME
CALL 총력전_스킬_공통_발동텍스트(시전자, -1, RESULTS, sTmp) ; 스오우:146
; 목표 처리
CALL 총력전_시퀀스_목표선택(주목표, 0, 총력전_선택_캐릭터)
; 목표 없으면 스킬 해제
IF 주목표 < 0
	CALL 총력전_스킬_공통_스킬취소(시전자)
	RETURN
ENDIF
; 범위로 변경, 적팀 1 이상이 되면 수정 필요
CALL 총력전_목표_범위(목표, 주목표, 1)
; 보호막 대미지
대미지 = GETVAR_RAIDSTAT_SUM(시전자, "공격력") * 97
대미지 = DIVIDE_ROUND(대미지, 100)
FOR iTmp, 0, 총력전_캐릭터수
	SIF 목표:iTmp < 0
		BREAK
	; 보호막 있는지 확인
	IF 총력전_상태효과_합계(목표:iTmp, 상효_종류_보호막, 총력전_방식_지속) > 0
		;@총력전_처리_피격(대미지, 수, 공 = -1, 회피 = 1, 치명타 = 1, 엄폐물 = 1, 상효적용 = 1, 카운터처리 = 1, 보호막만 = 0)
		CALL 총력전_처리_피격(대미지, 목표:iTmp, 시전자, 1, 1, 1, 1, 1, 1)
	ENDIF
NEXT
; 대미지
대미지 = GETVAR_RAIDSTAT_SUM(시전자, "공격력") * 100
대미지 = DIVIDE_ROUND(대미지, 100)
FOR iTmp, 0, 총력전_캐릭터수
	SIF 목표:iTmp < 0
		BREAK
	FOR iTmp:1, 0, 2
		CALL 총력전_처리_피격(대미지, 목표:iTmp, 시전자)
	NEXT
NEXT
