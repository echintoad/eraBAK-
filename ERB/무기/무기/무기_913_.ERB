;------------------------------------------
;이름
;+ 무기 있는지 확인용
;------------------------------------------
@무기_이름_913(iLen = 0)
#DIM DYNAMIC iLen
; 아비도스, 이집트 신화
;	잊혀진 과거
;	과거의 영광
; 세트, 오사이러스 관짝 못 박기 (technically Set's followers, but moving on)
; + 레일 스파이크 (하이랜더 관련)
; 문제: 아오바 처럼 엔지니어가 쓸만한 이름들;;;
;	Hammer & Nail (무기 2개) (super shorty 도 만들거면...)
;	Final Nail (Spike)
;	종결의 쐐기
; 세트, 아펩 사냥, 호시노 "새벽의 호루스" 상반
;	황혼(심야)의 사냥꾼
RESULTS = 황혼의 사냥꾼

;------------------------------------------
;착용 효과 (대상, 착용 1,미착용 -1)
;------------------------------------------
@무기_착용_913(대상, 탈착 = 1)
#DIM 대상
#DIM 탈착
#DIM 스탯증가, 2
IF 대상 >= 0 && NO:대상 == 146
	스탯증가:0 = 15 ; 무투
	스탯증가:1 = 15 ; 방위
ELSE
	스탯증가:0 = 7 ; 무투
	스탯증가:1 = 7 ; 방위
ENDIF
; 스탯
ABL:대상:무투 += 스탯증가:0 * 탈착
ABL:대상:방위 += 스탯증가:1 * 탈착

IF 탈착 == 1
	TALENT:대상:웨폰 = 913
	CALL SKILL_LEARN(대상, 스킬_장르_SP, 1913, 0)
ELSEIF 탈착 == -1
	TALENT:대상:웨폰 = 0
	; chariot was apparently first ones to engage normally
	; couldn't find formation / maneuver names related to them tho
	CALL SKILL_FORGET_BY_NAME(대상, 스킬_장르_SP, "충격 전술") ; 진격, 돌격, 충격 전술
ENDIF

RETURN 탈착

;------------------------------------------
; 임시: 총력전 스탯 추가
; 나중에 총력전 장비 스탯 정리 하면서 같이 처리 되도록 변경
;------------------------------------------
@무기_총력전스탯_913(대상)
#DIM 대상
VARSET RESULT, 0 ; WEAPON.ERH 참조
IF 대상 >= 0 && NO:대상 == 146
	RESULT:총력전_무기_최대체력 = 200
	RESULT:총력전_무기_공격력 = 20
	RESULT:총력전_무기_방어력 = 10
ELSE
	RESULT:총력전_무기_최대체력 = 100
	RESULT:총력전_무기_공격력 = 10
	RESULT:총력전_무기_방어력 = 5
ENDIF

;------------------------------------------
;무기설명
;------------------------------------------
@무기_설명_스탯_913(isRaid = 0)
#DIM DYNAMIC isRaid
IF isRaid
	CALL ICPRINT(@"스오우: 최대체력: <200> 공격력: <20> 방어력: <10>", "L", 칼라_주의)
	CALL ICPRINT(@"나머지: 최대체력: <100> 공격력: <10> 방어력: <5>", "L", 칼라_주의)
ELSE
	CALL ICPRINT(@"스오우: 무투: <15> 방위: <15>", "L", 칼라_주의)
	CALL ICPRINT(@"나머지: 무투: <7> 방위: <7>", "L", 칼라_주의)
ENDIF

@무기_설명_913
CALL SINGLE_DRAWLINE
PRINTL 전용스킬
PRINTL 
CALL SKILL_1913_SP_0_NAME
SETCOLOR 칼라_선택불가
PRINT   · 
RESETCOLOR
PRINTFORML %RESULTS%
CALL COLOR_LINE
SETCOLOR 칼라_선택불가
PRINT   · 
RESETCOLOR
CALL SKILL_1913_SP_0_EXPLANATION
PRINTFORML %RESULTS%
PRINTL
SETCOLOR 칼라_선택불가
PRINT   · 
RESETCOLOR
CALL ICPRINT(@"영향 받는 능력치 : <무투> , <방위>", "L", 칼라_주의)
PRINTL 
RETURN