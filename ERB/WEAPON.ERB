; trycall 필요, #FUNCTIONS 제거
@WEAPON_NAME(ARG, iLen = 0)
; #FUNCTIONS
#DIM DYNAMIC iLen
#LOCALSSIZE 1

TRYCCALLFORM 무기_이름_{ARG}(iLen)
	; RESULTS = %RESULTS%
	RETURN
CATCH
ENDCATCH
LOCALS = 
SELECTCASE ARG
	CASE 105    
		IF iLen > 0 && iLen < 21
			LOCALS = 마이 네세시티(수)
		ELSEIF iLen > 0 && iLen < 29
			LOCALS = 마이 네세시티(수영복)
		ELSE
			LOCALS = 마이 네세시티 + 크루세이더 쨩
		ENDIF
	CASE 304
		LOCALS = 라이브용 T셔츠 캐논
	CASE 413
		IF iLen > 0 && iLen < 14
			LOCALS = 치스토카(온)
		ELSEIF iLen > 0 && iLen < 21
			LOCALS = 치스토카(온천)
		ELSE 		;123456789012345678901234567890
			LOCALS = 치스토카 + 숙청군 1호
		ENDIF
	CASE 503 ; 노노미 미니 No.5?
		LOCALS = 리틀 머신건 V
	CASE 602
		IF iLen > 0 && iLen < 19
			LOCALS = 팬시 라이트(응)
		ELSE 		;12345678901234567890
			LOCALS = 팬시 라이트(응원단)
		ENDIF
	CASE 1114
		IF iLen > 0 && iLen < 19
			LOCALS = 진홍빛 재앙(수)
		ELSE 		;12345678901234567890
			LOCALS = 진홍빛 재앙(수영복)
		ENDIF
	CASEELSE
		LOCALS = 
ENDSELECT
RESULTS = %LOCALS% 
RETURN

@WEAPON_TYPE(ARG)
#FUNCTIONS
#LOCALSSIZE 1
LOCALS = 
SELECTCASE ARG
	CASE 100 TO 199
		LOCALS = 돌격소총(AR)
	CASE 200 TO 299
		LOCALS = 화염방사기(FT)
	CASE 300 TO 399
		LOCALS = 유탄발사기(GL)
	CASE 400 TO 499
		LOCALS = 권총(HG)
	CASE 500 TO 599
		LOCALS = 기관총(MG)
	CASE 600 TO 699
		LOCALS = 박격포(MT)
	CASE 700 TO 799
		LOCALS = 레일건(RG)
	CASE 800 TO 899
		LOCALS = 로켓런처(RL)
	CASE 900 TO 999
		LOCALS = 산탄총(SG)
	CASE 1000 TO 1099
		LOCALS = 기관단총(SMG)
	CASE 1100 TO 1199
		LOCALS = 저격소총(SR)
ENDSELECT
RETURNF LOCALS

;무기 종류 출력과 버튼화
@WEAPON_MENU(대상, 버튼활성화)
#DIM 대상
#DIM 버튼활성화
#DIM DYNAMIC 무기
#DIM DYNAMIC 줄당버튼
#LOCALSIZE 2
#LOCALSSIZE 1

CALL ICPRINT(@"현재 <%ANAME(대상)%>의 무기", "L", 칼라_주의)
IF FLAG:화상설정
	CALL WEAPON_IMAGE(TALENT:대상:웨폰, 7, 0)
	PRINTL
	PRINTL
ENDIF
CALL WEAPON_NAME(TALENT:대상:웨폰)
PRINTFORML [%RESULTS, 30, LEFT%]
TRYCALLFORM 무기_설명_스탯_{TALENT:대상:웨폰}(총력전무기스킬)
;---------------------------------------스킬설명부분---------------------------------------
IF 총력전무기스킬 == 0
	TRYCALLFORM 무기_설명_{TALENT:대상:웨폰}
ELSEIF 총력전무기스킬 == 1
	CALL SINGLE_DRAWLINE
	PRINTL 총력전스킬
	PRINTL 
	SETCOLOR 칼라_선택불가
	PRINT   · 
	RESETCOLOR
	RESULTS = 
	TRYCALLFORM SKILL_{TALENT:대상:웨폰+1000}_SP_0_NAME
	TRYCALLFORM SKILL_{TALENT:대상:웨폰+1000}_BASE_0_NAME
	TRYCALLFORM SKILL_{TALENT:대상:웨폰+1000}_CAPTURE_0_NAME
	TRYCALLFORM SKILL_{TALENT:대상:웨폰+1000}_ESCAPE_0_NAME
	PRINTFORML %RESULTS%
	CALL COLOR_LINE
	SETCOLOR 칼라_선택불가
	PRINT   · 
	RESETCOLOR
	RESULTS = 
	TRYCALLFORM 총력전_스킬_{TALENT:대상:웨폰+1000}_설명
	PRINTFORML %RESULTS%
	PRINTL
	TRYCALLFORM 총력전_스킬_{TALENT:대상:웨폰+1000}_코스트
	SETCOLOR 칼라_선택불가
	PRINT   · 
	RESETCOLOR
	PRINTFORML 코스트: {RESULT}
	PRINTL
ENDIF
CALL SINGLE_DRAWLINE
PRINTBUTTON "[스킬설명 변경]", 99
PRINTL 

; 무기 버튼
; 고유 무기/특수 무기? 아이+선생도 쓸수 있어서...
; 그냥 WEAPON_NEXT 사용?
줄당버튼 = 0 ; 줄당 버튼 확인
CALL SINGLE_DRAWLINE
PRINTL 고유 무기
FOR LOCAL, 501, 웨폰_TALENT_MAX
	; 0 이면 건너뛰기
	IF TALENT:대상:LOCAL <= 0
		; DEBUGPRINTFORML skip {LOCAL}
		CONTINUE
	ENDIF
	; BIT 확인
	FOR LOCAL:1, 0, 63
		; BIT 확인
		; DEBUGPRINTFORML check ({LOCAL}:{LOCAL:1})
		; 있으면 버튼 스폰
		IF GETBIT(TALENT:대상:LOCAL, LOCAL:1)
			무기 = (LOCAL-501) * 63 + LOCAL:1 + 100
			; DEBUGPRINTFORML %CALLNAME:대상% has weapon {무기} ({LOCAL}:{LOCAL:1})
			; 장착중인 무기 확인
			IF 무기 != TALENT:대상:웨폰
				CALL WEAPON_NAME(무기, 20)
				LOCALS = %RESULTS%
				SIF STRLENS(LOCALS) <= 0
					CONTINUE
				IF 버튼활성화
					PRINTBUTTON @"{무기,4,RIGHT}[%ALIGN_TEXT(RESULTS, 20, "LEFT")%]", 무기
				ELSE
					PRINTFORM {무기,4,RIGHT}[%ALIGN_TEXT(RESULTS, 20, "LEFT")%]
				ENDIF
				; 줄 정리
				IF 줄당버튼 >= 3
					PRINTL
					줄당버튼 = 0
				ELSE
					PRINTFORM %TOSTR_SPACE(1)%
					줄당버튼++
				ENDIF
			; ELSE
				; DEBUGPRINTL weapon is equipped
			ENDIF
			; 확인후 계속 확인해야 되나 확인
			; DEBUGPRINTFORML ({TALENT:대상:LOCAL} < {1 << (LOCAL:1 + 1)})
			IF TALENT:대상:LOCAL < (1 << (LOCAL:1 + 1))
				; DEBUGPRINTFORML no more in {LOCAL}
				BREAK
			ENDIF
		ENDIF
	NEXT
NEXT
PRINTL

; 양산형 무기
CALL SINGLE_DRAWLINE
PRINTL 양산형 무기
LOCAL:1 = 0
VARSIZE 웨폰_양산무기
FOR LOCAL, 0, RESULT
	SIF 웨폰_양산무기:LOCAL == TALENT:대상:웨폰
		CONTINUE
	CALL WEAPON_NAME(웨폰_양산무기:LOCAL, 20)
	LOCALS = %RESULTS%
	SIF STRLENS(LOCALS) <= 0
		CONTINUE
	IF 버튼활성화
		PRINTBUTTON @"{웨폰_양산무기:LOCAL,4,RIGHT}[%ALIGN_TEXT(RESULTS, 20, "LEFT")%]", 웨폰_양산무기:LOCAL
	ELSE
		PRINTFORM {웨폰_양산무기:LOCAL,4,RIGHT}[%ALIGN_TEXT(RESULTS, 20, "LEFT")%]
	ENDIF
	IF LOCAL:1 >= 3
		PRINTL
		LOCAL:1 = 0
	ELSE
		PRINTFORM %TOSTR_SPACE(1)%
		LOCAL:1++
	ENDIF
NEXT
PRINTL 

; 무기 선택 -> 확인 -> 장착
@WEAPON_MENU_SELECT(대상, 무기)
#DIM 대상
#DIM 무기

CALL SINGLE_DRAWLINE
PRINTL
IF FLAG:화상설정
	CALL WEAPON_IMAGE(무기, 7, 0)
	PRINTL
	PRINTL
ENDIF
CALL WEAPON_NAME(무기)
PRINTFORML [%RESULTS, 30, LEFT%]
PRINTL 
TRYCALLFORM 무기_설명_{무기}
CALL SINGLE_DRAWLINE
PRINTL 이 무기를 선택합니까?
PRINTBUTTON @" 0[ 네 ]", 0
PRINT  
PRINTBUTTON @" 1[ 아니오 ]", 1
PRINTL 
INPUT

IF RESULT == 0 ; YES
	CALL WEAPON_EQUIP(대상, 무기)
	PRINTL SELECTED WEAPON
	RETURN
ELSE ; NO
	PRINTL CANCEL SELECTED WEAPON
	RETURN
ENDIF
PRINTL NO MATCH

;-------------------------------------------------
;캐릭터 무기 장착
;-------------------------------------------------
@WEAPON_EQUIP(대상, 무기)
#DIM 대상
#DIM 무기
TRYCALLFORM 무기_착용_{TALENT:대상:웨폰}(대상,-1)
TRYCCALLFORM 무기_착용_{무기}(대상,1)
CATCH
	TALENT:대상:웨폰 = 무기
ENDCATCH

;-------------------------------------------------
;캐릭터가 사용 가능한 무기 추가 / 제거
;-------------------------------------------------
@WEAPON_ADD(대상, 무기)
#DIM 대상
#DIM 무기
#LOCALSIZE 2

; 양산형 이면 무시?
SIF MATCH(웨폰_양산무기, 무기)
	RETURN
SIF 무기 < 100
	RETURN

; 이진수 버전 (0~63)
; 무기 번호 100 ~ 1200 까진 17 변수 필요(17, 11 Bit)
; 예. 무기 1199 GETBIT(TALENT:518, 11) == 1
LOCAL:1 = 무기 - 100
LOCAL:0 = LOCAL:1 / 63 + 501
LOCAL:1 = LOCAL:1 % 63
SETBIT TALENT:대상:LOCAL, LOCAL:1


@WEAPON_REMOVE(대상, 무기)
#DIM 대상
#DIM 무기
; #DIM DYNAMIC 변경 ; bool
#LOCALSIZE 2

; 양산형 이면 무시?
SIF MATCH(웨폰_양산무기, 무기)
	RETURN
SIF 무기 < 100
	RETURN

LOCAL:1 = 무기 - 100
LOCAL:0 = LOCAL:1 / 63 + 501
LOCAL:1 = LOCAL:1 % 63
CLEARBIT TALENT:대상:LOCAL, LOCAL:1


; 대상이 무기가 있는지
@WEAPON_OWNED(대상, 무기)
#FUNCTION
#DIM 대상
#DIM 무기
#LOCALSIZE 2

; 양산형
SIF MATCH(웨폰_양산무기, 무기)
	RETURNF 1
SIF 무기 < 100
	RETURNF 0

LOCAL:1 = 무기 - 100
LOCAL:0 = LOCAL:1 / 63 + 501
LOCAL:1 = LOCAL:1 % 63
RETURNF GETBIT(TALENT:대상:LOCAL, LOCAL:1)

; 고유 무기 중 다음 장착 가능한 무기 번호
; 없으면 -1
@WEAPON_NEXT(대상, 확인번호)
#FUNCTION
#DIM 대상
#DIM 확인번호
#DIM DYNAMIC bitchk
#LOCALSIZE 2

; 오류방지
SIF 확인번호 < 100
	RETURNF -1
bitchk = (확인번호 - 100) % 63
확인번호 = (확인번호 - 100) / 63 + 501
FOR LOCAL, 확인번호, 웨폰_TALENT_MAX
	; 0 이면 건너뛰기
	IF TALENT:대상:LOCAL <= 0
		bitchk = 0
		CONTINUE
	ENDIF
	; BIT 확인
	FOR LOCAL:1, bitchk, 63
		; BIT 확인
		SIF GETBIT(TALENT:대상:LOCAL, LOCAL:1)
			RETURNF (LOCAL-501) * 63 + LOCAL:1 + 100
		IF TALENT:대상:LOCAL < (1 << (LOCAL:1 + 1))
			BREAK
		ENDIF
	NEXT
	bitchk = 0
NEXT
RETURNF -1

; 갖고 있는 무기 개수
@WEAPON_NUM(대상)
#FUNCTION
#DIM 대상
#DIM DYNAMIC num
#LOCALSIZE 2

FOR LOCAL, 501, 웨폰_TALENT_MAX
	; 0 이면 건너뛰기
	SIF TALENT:대상:LOCAL <= 0
		CONTINUE
	FOR LOCAL:1, 0, 63
		SIF GETBIT(TALENT:대상:LOCAL, LOCAL:1)
			num++
		IF TALENT:대상:LOCAL < (1 << (LOCAL:1 + 1))
			BREAK
		ENDIF
	NEXT
NEXT
RETURNF num

; n 번째 무기, 0 부터 시작
@WEAPON_NTH(대상, 무기)
#FUNCTION
#DIM 대상
#DIM 무기
#DIM DYNAMIC num = -1
#LOCALSIZE 2

FOR LOCAL, 501, 웨폰_TALENT_MAX
	; 0 이면 건너뛰기
	SIF TALENT:대상:LOCAL <= 0
		CONTINUE
	FOR LOCAL:1, 0, 63
		IF GETBIT(TALENT:대상:LOCAL, LOCAL:1)
			num++
			IF num >= 무기
				RETURNF (LOCAL-501) * 63 + LOCAL:1 + 100
			ENDIF
		ENDIF
		IF TALENT:대상:LOCAL < (1 << (LOCAL:1 + 1))
			BREAK
		ENDIF
	NEXT
NEXT
RETURNF -1