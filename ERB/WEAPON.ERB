; trycall 필요, #FUNCTIONS 제거
@WEAPON_NAME(ARG, iLen = 0)
; #FUNCTIONS
#DIM DYNAMIC iLen
#LOCALSSIZE 1

TRYCCALLFORM 무기_이름_{ARG}(iLen)
	; RESULTS = %RESULTS%
	RETURN
CATCH
ENDCATCH
LOCALS = 
SELECTCASE ARG
	CASE 105    
		IF iLen > 0 && iLen < 21
			LOCALS = 마이 네세시티(수)
		ELSEIF iLen > 0 && iLen < 29
			LOCALS = 마이 네세시티(수영복)
		ELSE
			LOCALS = 마이 네세시티 + 크루세이더 쨩
		ENDIF
	CASE 304
		LOCALS = 라이브용 T셔츠 캐논
	CASE 413
		IF iLen > 0 && iLen < 14
			LOCALS = 치스토카(온)
		ELSEIF iLen > 0 && iLen < 21
			LOCALS = 치스토카(온천)
		ELSE 		;123456789012345678901234567890
			LOCALS = 치스토카 + 숙청군 1호
		ENDIF
	CASE 503 ; 노노미 미니 No.5?
		LOCALS = 리틀 머신건 V
	CASE 602
		IF iLen > 0 && iLen < 19
			LOCALS = 팬시 라이트(응)
		ELSE 		;12345678901234567890
			LOCALS = 팬시 라이트(응원단)
		ENDIF
	CASE 1114
		IF iLen > 0 && iLen < 19
			LOCALS = 진홍빛 재앙(수)
		ELSE 		;12345678901234567890
			LOCALS = 진홍빛 재앙(수영복)
		ENDIF
	CASEELSE
		LOCALS = 
ENDSELECT
RESULTS = %LOCALS% 
RETURN

@WEAPON_TYPE(ARG)
#FUNCTIONS
#LOCALSSIZE 1
LOCALS = 
SELECTCASE ARG
	CASE 100 TO 199
		LOCALS = 돌격소총(AR)
	CASE 200 TO 299
		LOCALS = 화염방사기(FT)
	CASE 300 TO 399
		LOCALS = 유탄발사기(GL)
	CASE 400 TO 499
		LOCALS = 권총(HG)
	CASE 500 TO 599
		LOCALS = 기관총(MG)
	CASE 600 TO 699
		LOCALS = 박격포(MT)
	CASE 700 TO 799
		LOCALS = 레일건(RG)
	CASE 800 TO 899
		LOCALS = 로켓런처(RL)
	CASE 900 TO 999
		LOCALS = 산탄총(SG)
	CASE 1000 TO 1099
		LOCALS = 기관단총(SMG)
	CASE 1100 TO 1199
		LOCALS = 저격소총(SR)
ENDSELECT
RETURNF LOCALS

@WEAPON_MENU(대상)
#DIM 대상
#DIM WEAPON_SELECT
#DIM FIRST_LINE
#LOCALSIZE 3
#LOCALSSIZE 1

FIRST_LINE = LINECOUNT
;무기 종류 출력과 버튼화
$INPUT_LOOP1
CLEARLINE LINECOUNT - FIRST_LINE
;---------------------------------------스킬설명부분---------------------------------------
CALL SINGLE_DRAWLINE
CALL ICPRINT(@"현재 <%ANAME(대상)%>의 무기", "L", 칼라_주의)
CALL SINGLE_DRAWLINE
IF FLAG:화상설정
	CALL WEAPON_IMAGE(TALENT:대상:웨폰, 7, 0)
	PRINTL
	PRINTL
ENDIF
CALL WEAPON_NAME(TALENT:대상:웨폰)
PRINTFORML [%RESULTS, 30, LEFT%]
TRYCALLFORM 무기_설명_스탯_{TALENT:대상:웨폰}(총력전무기스킬)
IF 총력전무기스킬 == 0
	TRYCALLFORM 무기_설명_{TALENT:대상:웨폰}
ELSEIF 총력전무기스킬 == 1
	CALL SINGLE_DRAWLINE
	PRINTL 총력전스킬
	PRINTL 
	SETCOLOR 칼라_선택불가
	PRINT   · 
	RESETCOLOR
	RESULTS = 
	TRYCALLFORM SKILL_{TALENT:대상:웨폰+1000}_SP_0_NAME
	TRYCALLFORM SKILL_{TALENT:대상:웨폰+1000}_BASE_0_NAME
	PRINTFORML %RESULTS%
	CALL COLOR_LINE
	SETCOLOR 칼라_선택불가
	PRINT   · 
	RESETCOLOR
	RESULTS = 
	TRYCALLFORM 총력전_스킬_{TALENT:대상:웨폰+1000}_설명
	PRINTFORML %RESULTS%
	PRINTL
	TRYCALLFORM 총력전_스킬_{TALENT:대상:웨폰+1000}_코스트
	SETCOLOR 칼라_선택불가
	PRINT   · 
	RESETCOLOR
	PRINTFORML 코스트: {RESULT}
	PRINTL
ENDIF
CALL SINGLE_DRAWLINE
PRINTBUTTON "스킬설명 변경",-2
PRINTL

; 무기 버튼
; 고유 무기/특수 무기? 아이+선생도 쓸수 있어서...
LOCAL:2 = 0 ; 줄당 버튼 확인
CALL SINGLE_DRAWLINE
PRINTL 고유 무기
FOR LOCAL, 501, 웨폰_TALENT_MAX
	; 0 이면 건너뛰기
	IF TALENT:대상:LOCAL == 0
		DEBUGPRINTFORML skip {LOCAL}
		CONTINUE
	ENDIF
	; BIT 확인
	FOR LOCAL:1, 0, 64
		; BIT 확인
		DEBUGPRINTFORML check ({LOCAL}:{LOCAL:1})
		; 있으면 버튼 스폰
		IF GETBIT(TALENT:대상:LOCAL, LOCAL:1)
			WEAPON_SELECT = (LOCAL-501) * 64 + LOCAL:1 + 100
			DEBUGPRINTFORML %CALLNAME:대상% has weapon {WEAPON_SELECT} ({LOCAL}:{LOCAL:1})
			; 장착중인 무기 확인
			IF WEAPON_SELECT == TALENT:대상:웨폰
				DEBUGPRINTL weapon is equipped
				GOTO NEXTLINE
			ENDIF
			CALL WEAPON_NAME(WEAPON_SELECT, 20)
			LOCALS = %RESULTS%
			SIF STRLENS(LOCALS) <= 0
				CONTINUE
			PRINTBUTTON @"{WEAPON_SELECT,4,RIGHT}[%ALIGN_TEXT(RESULTS, 20, "LEFT")%]", WEAPON_SELECT
			; 줄 정리
			IF LOCAL:2 >= 3
				PRINTL
				LOCAL:2 = 0
			ELSE
				PRINTFORM %TOSTR_SPACE(1)%
				LOCAL:2++
			ENDIF
			$NEXTLINE
			; 확인후 계속 확인해야 되나 확인
			DEBUGPRINTFORML ({TALENT:대상:LOCAL} < {1 << (LOCAL:1 + 1)})
			IF TALENT:대상:LOCAL < (1 << (LOCAL:1 + 1))
				DEBUGPRINTFORML no more in {LOCAL}
				BREAK
			ENDIF
		ENDIF
	NEXT
NEXT
PRINTL

; 양산형 무기
CALL SINGLE_DRAWLINE
PRINTL 양산형 무기
LOCAL:1 = 0
VARSIZE 웨폰_양산무기
FOR LOCAL, 0, RESULT
	SIF 웨폰_양산무기:LOCAL == TALENT:대상:웨폰
		CONTINUE
	CALL WEAPON_NAME(웨폰_양산무기:LOCAL, 20)
	LOCALS = %RESULTS%
	SIF STRLENS(LOCALS) <= 0
		CONTINUE
	PRINTBUTTON @"{웨폰_양산무기:LOCAL,4,RIGHT}[%ALIGN_TEXT(RESULTS, 20, "LEFT")%]", 웨폰_양산무기:LOCAL
	IF LOCAL:1 >= 3
		PRINTL
		LOCAL:1 = 0
	ELSE
		PRINTFORM %TOSTR_SPACE(1)%
		LOCAL:1++
	ENDIF
NEXT
PRINTL
PRINTFORML [-1] 뒤로
INPUT
;---------------------------------------스킬설명부분---------------------------------------

SELECTCASE RESULT
	CASE -1 ; 뒤로
		RETURN
	CASE -2 ; 스킬 설명 변경
		총력전무기스킬 = !총력전무기스킬
		GOTO INPUT_LOOP1
	CASEELSE
		; PRINTFORM RESULT = {RESULT}
		; GOTO INPUT_LOOP1
		WEAPON_SELECT = RESULT
		CALL SINGLE_DRAWLINE
		PRINTL
		IF FLAG:화상설정
			CALL WEAPON_IMAGE(WEAPON_SELECT, 7, 0)
			PRINTL
			PRINTL
		ENDIF
		CALL WEAPON_NAME(WEAPON_SELECT)
		PRINTFORML [%RESULTS, 30, LEFT%]
		PRINTL 
		TRYCALLFORM 무기_설명_{WEAPON_SELECT}
		CALL SINGLE_DRAWLINE
		PRINTL 이 무기를 선택합니까?
		PRINTFORML [0] 네 [1] 아니요
		INPUT
		IF RESULT == 1
			GOTO INPUT_LOOP1
		ELSE
			CALL WEAPON_EQUIP(대상, WEAPON_SELECT)
			GOTO INPUT_LOOP1
			; RETURN
		ENDIF
ENDSELECT

;-------------------------------------------------
;캐릭터 무기 장착
;-------------------------------------------------
@WEAPON_EQUIP(대상, 무기)
#DIM 대상
#DIM 무기
TRYCALLFORM 무기_착용_{TALENT:대상:웨폰}(대상,-1)
TRYCCALLFORM 무기_착용_{무기}(대상,1)
CATCH
	TALENT:대상:웨폰 = 무기
ENDCATCH

;-------------------------------------------------
;캐릭터가 사용 가능한 무기 추가 / 제거
;-------------------------------------------------
@WEAPON_ADD(대상, 무기)
#DIM 대상
#DIM 무기
#LOCALSIZE 2

; 양산형 이면 무시?
IF MATCH(웨폰_양산무기, 무기)
	RETURN
ENDIF

; 이진수 버전 (0~63)
; 무기 번호 100 ~ 1200 까진 17 변수 필요(17, 11 Bit)
; 예. 무기 1199 GETBIT(TALENT:518, 11) == 1
LOCAL:1 = 무기 - 100
LOCAL:0 = LOCAL:1 / 64 + 501
LOCAL:1 = LOCAL:1 % 64
SETBIT TALENT:대상:LOCAL, LOCAL:1


@WEAPON_REMOVE(대상, 무기)
#DIM 대상
#DIM 무기
; #DIM DYNAMIC 변경 ; bool
#LOCALSIZE 2

; 양산형 이면 무시?
IF MATCH(웨폰_양산무기, 무기)
	RETURN
ENDIF

LOCAL:1 = 무기 - 100
LOCAL:0 = LOCAL:1 / 64 + 501
LOCAL:1 = LOCAL:1 % 64
CLEARBIT TALENT:대상:LOCAL, LOCAL:1


; 대상이 무기가 있는지
@WEAPON_OWNED(대상, 무기)
#FUNCTION
#DIM 대상
#DIM 무기
#LOCALSIZE 2

; 양산형
IF MATCH(웨폰_양산무기, 무기)
	RETURNF 1
ENDIF

LOCAL:1 = 무기 - 100
LOCAL:0 = LOCAL:1 / 64 + 501
LOCAL:1 = LOCAL:1 % 64
RETURNF GETBIT(TALENT:대상:LOCAL, LOCAL:1)