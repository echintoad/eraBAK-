@타입설명(ARG)
#FUNCTIONS
LOCAL = ARG % 9
LOCALS = 
SELECTCASE LOCAL
	CASE 0 ; 모자
		LOCALS = 강화시 명중률(T4), 치명타 대미지가(T7) 추가된다
	CASE 1 ; 장갑
		LOCALS = 강화시 지략(T4), 치명타(T4), 치명타 대미지가(T7) 추가된다
	CASE 2 ; 신발
		LOCALS = 강화시 방위(T4), 회피율(T4), CC강화가(T7) 추가된다
	CASE 3 ; 가방
		LOCALS = 강화시 방어력(T4), 치명 대미지 저항이(T7) 추가된다
	CASE 4 ; 배지
		LOCALS = 강화시 방위(T4), 회피율(T4), 방어력이(T7) 추가된다
	CASE 5 ; 헤어핀
		LOCALS = 강화시 무투(T4), CC저항(T4), 치명타 저항이(T7) 추가된다
	CASE 6 ; 에뮬렛
		LOCALS = 강화시 CC강화(T4), CC저항(T4), 정치가(T7) 추가된다
	CASE 7 ; 손목 시계
		LOCALS = 강화시 가창(T4), 명중률이(T7) 추가된다
	CASE 8 ; 목걸이
		LOCALS = 강화시 정치(T4), 회피율(T4), CC저항이(T7) 추가된다
ENDSELECT
RETURNF LOCALS

; 캐릭터 정보창 장비 변경 창
@장비변경(대상, 버튼활성화)
#DIM 대상
#DIM 버튼활성화
#DIMS DYNAMIC sHtml
#DIM CONST 셀너비 = 29
#LOCALSIZE 3
#LOCALSSIZE 1

CALL SINGLE_DRAWLINE
CALL ICPRINT(@"현재 <%ANAME(대상)%>의 장비", "L", 칼라_주의)
CALL SINGLE_DRAWLINE
; LOCAL:0 = 29
; LOCAL:1 = LOCAL:0 * 3 + 2
PRINTFORM %TOSTR_SPACE(3)%|%TOSTR_REPEAT("-",셀너비 / 2 - 5)%%ALIGN_TEXT("1 슬롯", 11, "CENTER")%%TOSTR_REPEAT("-",셀너비 / 2 - 5)%|
PRINTFORM %TOSTR_REPEAT("-",셀너비 / 2 - 5)%%ALIGN_TEXT("2 슬롯", 11, "CENTER")%%TOSTR_REPEAT("-",셀너비 / 2 - 5)%|
PRINTFORML %TOSTR_REPEAT("-",셀너비 / 2 - 5)%%ALIGN_TEXT("3 슬롯", 11, "CENTER")%%TOSTR_REPEAT("-",셀너비 / 2 - 5)%|
; 화상 설정
IF FLAG:화상설정
	PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|
	PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|
	; PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|
	PRINTL
	; 이미지 추가
	IF 대상 >= 0
		sHtml = 
		FOR LOCAL, 0, 3
			IF LOCAL == 0
				LOCALS = %TOSTR_SPACE(11)%
			ELSE
				LOCALS = %TOSTR_SPACE(15)%
			ENDIF
			; CALL PRINT_HTML_IMAGE("장비_더미", 7, 3, 4)
			; LOCALS += @"%RESULTS%"
			CALL 장비이름(착용장비:대상:LOCAL)
			IF RESULTS == "없음"
				LOCALS += @"%TOSTR_SPACE(15)%"
			ELSE
				CALL PRINT_HTML_IMAGE(RESULTS, 7, 3, 4)
				LOCALS += @"%RESULTS%"
			ENDIF
			sHtml += @"%LOCALS%"
		NEXT
		HTML_PRINT sHtml
	ENDIF
	PRINTL
	; PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|
	PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|
ENDIF
; PRINTFORML %TOSTR_REPEAT("H", 셀너비 * 3 + 7)%
; PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_REPEAT("-", 8)%H%TOSTR_SPACE(LOCAL - 18)%H%TOSTR_REPEAT("-", 8)%|%TOSTR_REPEAT("-", 8)%H%TOSTR_SPACE(LOCAL - 18)%H%TOSTR_REPEAT("-", 8)%|%TOSTR_REPEAT("-", 8)%H%TOSTR_SPACE(LOCAL - 18)%H%TOSTR_REPEAT("-", 8)%|
PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|
; 버튼 줄
LOCAL:1 = 셀너비 - 4
PRINTFORM %TOSTR_SPACE(2)%
LOCALS =
LOCALS += @" | "
PRINTFORM %LOCALS%
; 스롯 버튼, 90, 91, 92
FOR LOCAL, 0, 3
	RESULTS = 
	CALL 장비이름(착용장비:대상:LOCAL)
	IF 버튼활성화
		PRINTBUTTON @"[%ALIGN_TEXT(RESULTS, LOCAL:1, "CENTER")%]", LOCAL + 90
	ELSE
		PRINTFORM [%ALIGN_TEXT(RESULTS, LOCAL:1, "CENTER")%]
	ENDIF
	PRINTFORM %LOCALS%
NEXT
PRINTL
; 화상 설정 추가
IF !FLAG:화상설정
	PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|
ENDIF
PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_REPEAT("-",셀너비)%|%TOSTR_REPEAT("-",셀너비)%|%TOSTR_REPEAT("-",셀너비)%|
PRINTL
IF 대상 < 0
	RETURN
ENDIF
; 스탯 합계 출력
CALL 총력전_장비_스탯_출력_캐릭터(대상)
; 각각 장비 스탯 출력, 칼라_주석 #8090A0 칼라_명회색 #777777 칼라_선택불가 #606060 칼라_회색 #404040
SETCOLOR 칼라_선택불가
FOR LOCAL, 0, 3
	CALL 장비이름(착용장비:대상:LOCAL, 16)
	SIF RESULTS == "없음"
		CONTINUE
	; 장비 이름
	PRINTFORM %ALIGN_TEXT(RESULTS, 16, "RIGHT")%: 
	; 장비 스탯
	CALL 총력전_장비_스탯_출력_하나(착용장비:대상:LOCAL) ; , 100
	FOR LOCAL:1, 0, RESULT
		IF LOCAL:1 != 0
			PRINTFORM %TOSTR_SPACE(18)%
		ENDIF
		PRINTFORML %RESULTS:(LOCAL:1)%
	NEXT
NEXT
RESETCOLOR

; 보유중인 장비 + 장착 버튼
@장비변경_보유(대상, 선택슬롯)
#DIM 대상
#DIM 선택슬롯
#DIM DYNAMIC 타입
#DIM DYNAMIC 장비번호
#DIM DYNAMIC bFirstOfType
#LOCALSIZE 2
#LOCALSSIZE 1

; 타입 장비이름 수 스탯
; %장비타입(10)%%장비이름(20)%%장비수(5)%%스탯(100)%
타입 = 선택슬롯 * 3
FOR LOCAL, 0, 3
	bFirstOfType = 1
	FOR 장비번호, 타입, 81
		; 없으면
		IF 장비:장비번호 <= 0
			장비번호 += 8 ; 9 - 1
			CONTINUE
		ENDIF
		; 장비 있으면 타입 프린트
		; 1234567890
		;  손목시계
		SETCOLOR 칼라_주석
		IF bFirstOfType == 1
			PRINTFORM %ALIGN_TEXT(장비타입(타입), 9, "RIGHT")% 
			bFirstOfType = 0
		ELSE
			PRINTFORM %TOSTR_SPACE(10)%
		ENDIF
		RESETCOLOR
		; 장비 버튼, 장비번호 + 100
		CALL 장비이름(장비번호, 18)
		IF 착용장비:대상:선택슬롯 == 장비번호
			SETCOLOR 칼라_선택불가
			PRINTFORM [%ALIGN_TEXT(RESULTS, 20, "RIGHT")%]
			RESETCOLOR
		ELSE
			PRINTBUTTON @"[%ALIGN_TEXT(RESULTS, 20, "RIGHT")%]", 장비번호 + 100
		ENDIF
		; 장비 수
		IF 장비:장비번호 > 999
			PRINT 많음 
		ELSE
			LOCALS = x{장비:장비번호}
			PRINTFORM %ALIGN_TEXT(LOCALS, 4, "RIGHT")% 
		ENDIF
		; 스탯
		CALL 총력전_장비_스탯_출력_하나(장비번호, 100)
		FOR LOCAL:1, 0, RESULT
			IF LOCAL:1 != 0
				PRINTFORM %TOSTR_SPACE(35)%
			ENDIF
			PRINTFORML %RESULTS:(LOCAL:1)%
		NEXT
		장비번호 += 8 ; 9 - 1
	NEXT
	타입 += 1
NEXT

; 장비 스탯, RESULT 에 줄수 추가, 사용 예시:
; [장비 이름] x2 무투:10  공격력:10  치명타 대미지:10
;                총력전 체력:10
