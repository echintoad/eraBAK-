; T1 ~ T3, T4 ~ T6, T7 ~ T9
;------------------------------------------

; trycall 필요, #FUNCTIONS 제거
@장비이름(ARG, iLen = 0)
; #FUNCTIONS
#DIM DYNAMIC iLen
#LOCALSSIZE 1

TRYCCALLFORM 총력전장비_이름_{ARG}(iLen)
	RETURN
CATCH
	RESULTS = 없음
	RETURN
ENDCATCH

@장비티어(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0 TO 8
		LOCALS = T1
	CASE 9 TO 17
		LOCALS = T2
	CASE 18 TO 26
		LOCALS = T3
	CASE 27 TO 35
		LOCALS = T4
	CASE 36 TO 44
		LOCALS = T5
	CASE 45 TO 53
		LOCALS = T6
	CASE 54 TO 62
		LOCALS = T7
	CASE 63 TO 71
		LOCALS = T8
	CASE 72 TO 80
		LOCALS = T9
ENDSELECT
RETURNF LOCALS

@강회비용코인(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 0 TO 8 ; T1 -> T2
	RETURNF 3
	CASE 9 TO 17 ; T2 -> T3
	RETURNF 6
	CASE 18 TO 26 ; T3 -> T4
	RETURNF 12
	CASE 27 TO 35 ; T4 -> T5
	RETURNF 14
	CASE 36 TO 44 ; T5 -> T6
	RETURNF 18
	CASE 45 TO 53 ; T6 -> T7
	RETURNF 21
	CASE 54 TO 62 ; T7 -> T8
	RETURNF 25
	CASE 63 TO 71 ; T8 -> T9
	RETURNF 30
	CASE 72 TO 80 ; T9 -> 몰루? 사용 안 함
	RETURNF 99
ENDSELECT
RETURNF -1

@강회비용상급코인(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 0 TO 8 ; T1 -> T2
	RETURNF 0
	CASE 9 TO 17 ; T2 -> T3
	RETURNF 0
	CASE 18 TO 26 ; T3 -> T4
	RETURNF 0
	CASE 27 TO 35 ; T4 -> T5
	RETURNF 2
	CASE 36 TO 44 ; T5 -> T6
	RETURNF 4
	CASE 45 TO 53 ; T6 -> T7
	RETURNF 7
	CASE 54 TO 62 ; T7 -> T8
	RETURNF 13
	CASE 63 TO 71 ; T8 -> T9
	RETURNF 20
	CASE 72 TO 80 ; T9 -> 몰루? 사용 안 함
	RETURNF 99
ENDSELECT
RETURNF -1

@강화비용크레딧(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 0 TO 8 ; T1 -> T2
	RETURNF 4000
	CASE 9 TO 17 ; T2 -> T3
	RETURNF 6000
	CASE 18 TO 26 ; T3 -> T4
	RETURNF 8000
	CASE 27 TO 35 ; T4 -> T5
	RETURNF 10000
	CASE 36 TO 44 ; T5 -> T6
	RETURNF 12000
	CASE 45 TO 53 ; T6 -> T7
	RETURNF 15000
	CASE 54 TO 62 ; T7 -> T8
	RETURNF 18000
	CASE 63 TO 71 ; T8 -> T9
	RETURNF 24000
	CASE 72 TO 80 ; T9 -> 몰루? 사용 안 함
	RETURNF 99999
ENDSELECT
RETURNF -1

@장비슬롯(ARG)
#FUNCTIONS
LOCAL = ARG % 9
SELECTCASE LOCAL
	CASE 0 TO 2
		LOCALS = 1슬롯
	CASE 3 TO 5
		LOCALS = 2슬롯
	CASE 6 TO 8
		LOCALS = 3슬롯
ENDSELECT
RETURNF LOCALS

@장비타입(ARG)
#FUNCTIONS
LOCAL = ARG % 9
SELECTCASE LOCAL
	CASE 0
		LOCALS = 모자
	CASE 1
		LOCALS = 장갑
	CASE 2
		LOCALS = 신발
	CASE 3
		LOCALS = 가방
	CASE 4
		LOCALS = 배지
	CASE 5
		LOCALS = 헤어핀
	CASE 6
		LOCALS = 부적
	CASE 7
		LOCALS = 손목시계
	CASE 8
		LOCALS = 목걸이
ENDSELECT
RETURNF LOCALS

@타입설명(ARG)
#FUNCTIONS
LOCAL = ARG % 9
LOCALS = 
SELECTCASE LOCAL
	CASE 0 ; 모자
		LOCALS = 강화시 명중률(T4), 치명타 대미지가(T7) 추가된다
	CASE 1 ; 장갑
		LOCALS = 강화시 지략(T4), 치명타(T4), 치명타 대미지가(T7) 추가된다
	CASE 2 ; 신발
		LOCALS = 강화시 방위(T4), 회피율(T4), CC강화가(T7) 추가된다
	CASE 3 ; 가방
		LOCALS = 강화시 방어력(T4), 치명 대미지 저항이(T7) 추가된다
	CASE 4 ; 배지
		LOCALS = 강화시 방위(T4), 회피율(T4), 방어력이(T7) 추가된다
	CASE 5 ; 헤어핀
		LOCALS = 강화시 무투(T4), CC저항(T4), 치명타 저항이(T7) 추가된다
	CASE 6 ; 에뮬렛
		LOCALS = 강화시 CC강화(T4), CC저항(T4), 정치가(T7) 추가된다
	CASE 7 ; 손목 시계
		LOCALS = 강화시 가창(T4), 명중률이(T7) 추가된다
	CASE 8 ; 목걸이
		LOCALS = 강화시 정치(T4), 회피율(T4), CC저항이(T7) 추가된다
ENDSELECT
RETURNF LOCALS

; 캐릭터 정보창 장비 변경 창
@장비변경(대상, 버튼활성화)
#DIM 대상
#DIM 버튼활성화
#DIMS DYNAMIC sHtml
#DIM CONST 셀너비 = 29
#LOCALSIZE 3
#LOCALSSIZE 1

CALL SINGLE_DRAWLINE
CALL ICPRINT(@"현재 <%ANAME(대상)%>의 장비", "L", 칼라_주의)
CALL SINGLE_DRAWLINE
; 장비 render
; 스롯 버튼, 90, 91, 92
CALL 장비변경_이미지(착용장비:대상:0, 착용장비:대상:1, 착용장비:대상:2, 90, 91, 92)
PRINTL
IF 대상 < 0
	RETURN
ENDIF
; 스탯 합계 출력
CALL 총력전_장비_스탯_출력_캐릭터(대상)
; 각각 장비 스탯 출력, 칼라_주석 #8090A0 칼라_명회색 #777777 칼라_선택불가 #606060 칼라_회색 #404040
SETCOLOR 칼라_선택불가
FOR LOCAL, 0, 3
	CALL 장비이름(착용장비:대상:LOCAL, 16)
	SIF RESULTS == "없음"
		CONTINUE
	; 장비 이름
	PRINTFORM %ALIGN_TEXT(RESULTS, 16, "RIGHT")%: 
	; 장비 스탯
	CALL 총력전_장비_스탯_출력_하나(착용장비:대상:LOCAL) ; , 100
	FOR LOCAL:1, 0, RESULT
		IF LOCAL:1 != 0
			PRINTFORM %TOSTR_SPACE(18)%
		ENDIF
		PRINTFORML %RESULTS:(LOCAL:1)%
	NEXT
NEXT
RESETCOLOR

@장비변경_이미지(슬롯1, 슬롯2, 슬롯3, 슬롯1_버튼 = -1, 슬롯2_버튼 = -1, 슬롯3_버튼 = -1)
#DIM 슬롯1 ; 1 슬롯 장비 번호
#DIM 슬롯2 ; 2 슬롯 장비 번호
#DIM 슬롯3 ; 3 슬롯 장비 번호
#DIM 장비번호, 3
#DIM DYNAMIC 슬롯1_버튼 ; 버튼 갑, -1 이면 비 활성화
#DIM DYNAMIC 슬롯2_버튼
#DIM DYNAMIC 슬롯3_버튼
#DIM 장비번호_버튼, 3
#DIMS DYNAMIC sHtml
#DIM CONST 셀너비 = 29
#LOCALSIZE 2
#LOCALSSIZE 1

장비번호:0 = 슬롯1
장비번호:1 = 슬롯2
장비번호:2 = 슬롯3
; 버튼
장비번호_버튼:0 = 슬롯1_버튼
장비번호_버튼:1 = 슬롯2_버튼
장비번호_버튼:2 = 슬롯3_버튼

PRINTFORM %TOSTR_SPACE(3)%|%TOSTR_REPEAT("-",셀너비 / 2 - 5)%%ALIGN_TEXT("1 슬롯", 11, "CENTER")%%TOSTR_REPEAT("-",셀너비 / 2 - 5)%|
PRINTFORM %TOSTR_REPEAT("-",셀너비 / 2 - 5)%%ALIGN_TEXT("2 슬롯", 11, "CENTER")%%TOSTR_REPEAT("-",셀너비 / 2 - 5)%|
PRINTFORML %TOSTR_REPEAT("-",셀너비 / 2 - 5)%%ALIGN_TEXT("3 슬롯", 11, "CENTER")%%TOSTR_REPEAT("-",셀너비 / 2 - 5)%|
; 화상 설정
IF FLAG:화상설정
	PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|
	PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|
	PRINTL
	; 이미지 추가
	sHtml = 
	FOR LOCAL, 0, 3
		IF LOCAL == 0
			LOCALS = %TOSTR_SPACE(11)%
		ELSE
			LOCALS = %TOSTR_SPACE(15)%
		ENDIF
		CALL 장비이름(장비번호:LOCAL)
		IF RESULTS == "없음"
			LOCALS += @"%TOSTR_SPACE(15)%"
		ELSE
			CALL PRINT_HTML_IMAGE(RESULTS, 7, 3, 4)
			LOCALS += @"%RESULTS%"
		ENDIF
		sHtml += @"%LOCALS%"
	NEXT
	HTML_PRINT sHtml
	PRINTL
	PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|
ENDIF
; PRINTFORML %TOSTR_REPEAT("H", 셀너비 * 3 + 7)%
PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|
; 버튼 줄
LOCAL:1 = 셀너비 - 4
PRINTFORM %TOSTR_SPACE(2)%
LOCALS =
LOCALS += @" | "
PRINTFORM %LOCALS%
; 스롯 버튼, 90, 91, 92
FOR LOCAL, 0, 3
	RESULTS = 
	CALL 장비이름(장비번호:LOCAL)
	IF 장비번호_버튼:LOCAL >= 0
		PRINTBUTTON @"[%ALIGN_TEXT(RESULTS, LOCAL:1, "CENTER")%]", 장비번호_버튼:LOCAL
	ELSE
		SETCOLOR 칼라_선택불가
		PRINTFORM [%ALIGN_TEXT(RESULTS, LOCAL:1, "CENTER")%]
		RESETCOLOR
	ENDIF
	PRINTFORM %LOCALS%
NEXT
PRINTL
; 화상 설정 추가
IF !FLAG:화상설정
	PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|%TOSTR_SPACE(셀너비)%|
ENDIF
PRINTFORML %TOSTR_SPACE(3)%|%TOSTR_REPEAT("-",셀너비)%|%TOSTR_REPEAT("-",셀너비)%|%TOSTR_REPEAT("-",셀너비)%|
PRINTL

; 보유중인 장비 + 장착 버튼
@장비변경_보유(대상, 선택슬롯)
#DIM 대상
#DIM 선택슬롯
#DIM DYNAMIC 타입
#DIM DYNAMIC 장비번호
#DIM DYNAMIC bFirstOfType
#LOCALSIZE 2
#LOCALSSIZE 1

; 타입 장비이름 수 스탯
; %장비타입(10)%%장비이름(20)%%장비수(5)%%스탯(100)%
타입 = 선택슬롯 * 3
FOR LOCAL, 0, 3
	bFirstOfType = 1
	FOR 장비번호, 타입, 81
		; 없으면
		IF 장비:장비번호 <= 0
			장비번호 += 8 ; 9 - 1
			CONTINUE
		ENDIF
		; 장비 있으면 타입 프린트
		; 1234567890
		;  손목시계
		SETCOLOR 칼라_주석
		IF bFirstOfType == 1
			PRINTFORM %ALIGN_TEXT(장비타입(타입), 9, "RIGHT")% 
			bFirstOfType = 0
		ELSE
			PRINTFORM %TOSTR_SPACE(10)%
		ENDIF
		RESETCOLOR
		; 장비 버튼, 장비번호 + 100
		CALL 장비이름(장비번호, 18)
		IF 착용장비:대상:선택슬롯 == 장비번호
			SETCOLOR 칼라_선택불가
			PRINTFORM [%ALIGN_TEXT(RESULTS, 20, "RIGHT")%]
			RESETCOLOR
		ELSE
			PRINTBUTTON @"[%ALIGN_TEXT(RESULTS, 20, "RIGHT")%]", 장비번호 + 100
		ENDIF
		; 장비 수
		IF 장비:장비번호 > 999
			PRINT 많음 
		ELSE
			LOCALS = x{장비:장비번호}
			PRINTFORM %ALIGN_TEXT(LOCALS, 4, "RIGHT")% 
		ENDIF
		; 스탯
		CALL 총력전_장비_스탯_출력_하나(장비번호, 100)
		FOR LOCAL:1, 0, RESULT
			IF LOCAL:1 != 0
				PRINTFORM %TOSTR_SPACE(35)%
			ENDIF
			PRINTFORML %RESULTS:(LOCAL:1)%
		NEXT
		장비번호 += 8 ; 9 - 1
	NEXT
	타입 += 1
NEXT

; 장비 스탯, RESULT 에 줄수 추가, 사용 예시:
; [장비 이름] x2 무투:10  공격력:10  치명타 대미지:10
;                총력전 체력:10
@총력전_장비_스탯_출력_하나(장비번호, 너비 = 100)
#DIM 장비번호
#DIM DYNAMIC 너비
#DIM DYNAMIC 스탯합, 24
#DIM DYNAMIC Line_Num

VARSET RESULT, 0
VARSET RESULTS, ""

TRYCCALLFORM 총력전장비_스탯_{장비번호}
	스탯합:추가스탯_최대체력 = RESULT:추가스탯_최대체력
	스탯합:추가스탯_최대기력 = RESULT:추가스탯_최대기력
	스탯합:추가스탯_최대정신력 = RESULT:추가스탯_최대정신력
	스탯합:추가스탯_무투 = RESULT:추가스탯_무투
	스탯합:추가스탯_방위 = RESULT:추가스탯_방위
	스탯합:추가스탯_지략 = RESULT:추가스탯_지략
	스탯합:추가스탯_정치 = RESULT:추가스탯_정치
	스탯합:추가스탯_신비 = RESULT:추가스탯_신비
	스탯합:추가스탯_가창 = RESULT:추가스탯_가창
	스탯합:추가스탯_요리 = RESULT:추가스탯_요리
	; 총력전 스탯
	스탯합:추가스탯_총력전체력 = RESULT:추가스탯_총력전체력
	스탯합:추가스탯_공격력 = RESULT:추가스탯_공격력
	스탯합:추가스탯_방어력 = RESULT:추가스탯_방어력
	스탯합:추가스탯_명중률 = RESULT:추가스탯_명중률
	스탯합:추가스탯_회피율 = RESULT:추가스탯_회피율
	스탯합:추가스탯_치유력 = RESULT:추가스탯_치유력
	스탯합:추가스탯_치명타 = RESULT:추가스탯_치명타
	스탯합:추가스탯_치명타저항 = RESULT:추가스탯_치명타저항
	스탯합:추가스탯_치명대미지 = RESULT:추가스탯_치명대미지
	스탯합:추가스탯_치명대미지저항 = RESULT:추가스탯_치명대미지저항
	스탯합:추가스탯_군중제어한계 = RESULT:추가스탯_군중제어한계
	스탯합:추가스탯_군중제어강화 = RESULT:추가스탯_군중제어강화
	스탯합:추가스탯_군중제어저항 = RESULT:추가스탯_군중제어저항
CATCH
ENDCATCH
CALL 총력전_장비_스탯_출력_텍스트(스탯합, 너비)
RETURN RESULT


; 캐릭터가 장착중인 장비 스탯 출력 (합)
@총력전_장비_스탯_출력_캐릭터(대상) ; 너비
#DIM 대상
; #DIM 너비
#DIM DYNAMIC 스탯합, 24
#DIM DYNAMIC Line_Num
#LOCALSIZE 1

FOR LOCAL, 0, 3
	; 착용장비:대상:슬롯
	IF 착용장비:대상:LOCAL >= 0
		; RESULT 에 스탯 받기
		TRYCCALLFORM 총력전장비_스탯_{착용장비:대상:LOCAL}
			스탯합:추가스탯_최대체력 += RESULT:추가스탯_최대체력
			스탯합:추가스탯_최대기력 += RESULT:추가스탯_최대기력
			스탯합:추가스탯_최대정신력 += RESULT:추가스탯_최대정신력
			스탯합:추가스탯_무투 += RESULT:추가스탯_무투
			스탯합:추가스탯_방위 += RESULT:추가스탯_방위
			스탯합:추가스탯_지략 += RESULT:추가스탯_지략
			스탯합:추가스탯_정치 += RESULT:추가스탯_정치
			스탯합:추가스탯_신비 += RESULT:추가스탯_신비
			스탯합:추가스탯_가창 += RESULT:추가스탯_가창
			스탯합:추가스탯_요리 += RESULT:추가스탯_요리
			; 총력전 스탯
			스탯합:추가스탯_총력전체력 += RESULT:추가스탯_총력전체력
			스탯합:추가스탯_공격력 += RESULT:추가스탯_공격력
			스탯합:추가스탯_방어력 += RESULT:추가스탯_방어력
			스탯합:추가스탯_명중률 += RESULT:추가스탯_명중률
			스탯합:추가스탯_회피율 += RESULT:추가스탯_회피율
			스탯합:추가스탯_치유력 += RESULT:추가스탯_치유력
			스탯합:추가스탯_치명타 += RESULT:추가스탯_치명타
			스탯합:추가스탯_치명타저항 += RESULT:추가스탯_치명타저항
			스탯합:추가스탯_치명대미지 += RESULT:추가스탯_치명대미지
			스탯합:추가스탯_치명대미지저항 += RESULT:추가스탯_치명대미지저항
			스탯합:추가스탯_군중제어한계 += RESULT:추가스탯_군중제어한계
			스탯합:추가스탯_군중제어강화 += RESULT:추가스탯_군중제어강화
			스탯합:추가스탯_군중제어저항 += RESULT:추가스탯_군중제어저항
		CATCH
		ENDCATCH
	ENDIF
NEXT
CALL 총력전_장비_스탯_출력_텍스트(스탯합, 100)
FOR LOCAL, 0, RESULT
	IF LOCAL == 0
			; 123456789_123456789_1
			;    베로니카 배지:
		PRINT        착용 효과: 
	ELSE
		PRINTFORM %TOSTR_SPACE(18)%
	ENDIF
	SETCOLOR 칼라_파파랑
	PRINTFORML %RESULTS:LOCAL%
	RESETCOLOR
NEXT

; "스탯합"으로 받은 스탯 출력, RESULT 에 줄수 출력
@총력전_장비_스탯_출력_텍스트(스탯합, 너비)
#DIM REF 스탯합, 0
#DIM 너비
#DIM DYNAMIC Line_Num
; #DIM DYNAMIC 스탯합_수정, 24 ; 오류 방지?
#LOCALSIZE 1
#LOCALSSIZE 1

VARSET RESULT, 0
VARSET RESULTS, ""

; VARSIZE 스탯합
; PRINTFORM 스탯합 사이즈: {RESULT}
VARSIZE 스탯합
IF RESULT < 24
	; 아님 스탯합_수정 으로 고쳐버리기?
	THROW 받은 배열 크기가 맞지 않습니다 = {VARSIZE(스탯합)}
ENDIF

FOR LOCAL, 1, 24 ; 추가스탯_군중제어저항 + 1
	IF 스탯합:LOCAL > 0
		SELECTCASE LOCAL
			CASE 추가스탯_최대체력
				LOCALS = 체력: 
			CASE 추가스탯_최대기력
				LOCALS = 기력: 
			CASE 추가스탯_최대정신력
				LOCALS = 정신력: 
			CASE 추가스탯_무투
				LOCALS = 무투: 
			CASE 추가스탯_방위
				LOCALS = 방위: 
			CASE 추가스탯_지략
				LOCALS = 지략: 
			CASE 추가스탯_정치
				LOCALS = 정치: 
			CASE 추가스탯_신비
				LOCALS = 신비: 
			CASE 추가스탯_가창
				LOCALS = 가창: 
			CASE 추가스탯_요리
				LOCALS = 요리: 
			CASE 추가스탯_총력전체력
				LOCALS = 총력전HP: 
			CASE 추가스탯_공격력
				LOCALS = 공격력: 
			CASE 추가스탯_방어력
				LOCALS = 방어력: 
			CASE 추가스탯_명중률
				LOCALS = 명중률: 
			CASE 추가스탯_회피율
				LOCALS = 회피율: 
			CASE 추가스탯_치유력
				LOCALS = 치유력: 
			CASE 추가스탯_치명타
				LOCALS = 치명타: 
			CASE 추가스탯_치명타저항
				LOCALS = 치명저항: 
			CASE 추가스탯_치명대미지
				LOCALS = 치댐: 
			CASE 추가스탯_치명대미지저항
				LOCALS = 치댐저항: 
			CASE 추가스탯_군중제어한계
				LOCALS = CC: 
			CASE 추가스탯_군중제어강화
				LOCALS = CC강화: 
			CASE 추가스탯_군중제어저항
				LOCALS = CC저항: 
		ENDSELECT
		LOCALS += @"{스탯합:LOCAL}"
		; 다음 줄로 넘어가야될지 확인
		STRLENFORM %RESULTS:Line_Num%, %LOCALS%
		IF RESULT > 너비
			Line_Num ++
		ELSE
			STRLENFORM %RESULTS:Line_Num%
			IF RESULT != 0 ; && Line_Num != 0
				RESULTS:Line_Num += @", "
			ENDIF
		ENDIF
		RESULTS:Line_Num += @"%LOCALS%"
	ENDIF
NEXT
RETURN Line_Num + 1

@총력전_장비_착용(대상,장비번호,슬롯,탈착)
#DIM 대상
#DIM 탈착
#DIM 슬롯
#DIM 장비번호

IF 탈착 == 1
	IF 착용장비:대상:슬롯 >= 0
		; 장착중인 장비 탈착
		CALL _총력전_장비_스탯(대상, 착용장비:대상:슬롯, -1)
		장비:(착용장비:대상:슬롯) ++
	ENDIF
	; 장비 장착
	CALL _총력전_장비_스탯(대상, 장비번호, 1)
	착용장비:대상:슬롯 = 장비번호
	장비:장비번호 --
ELSEIF 탈착 == -1
	; 장비 탈착
	IF 착용장비:대상:슬롯 >= 0
		CALL _총력전_장비_스탯(대상, 착용장비:대상:슬롯, -1)
		착용장비:대상:슬롯 = -1
		장비:장비번호 ++
	ENDIF
ELSE
	; 추가 에러 메세지?
	RETURN
ENDIF

; 스탯 증가/감소
; @총력전_장비_착용 으로만 작동
; 임시: _UPDATE_000606_EQUIP_STATCHANGE 에서도 사용
@_총력전_장비_스탯(대상, 장비번호, 탈착)
#DIM 대상
#DIM 탈착
#DIM 슬롯
#DIM 장비번호

; RESULT 에 스탯 받기
TRYCCALLFORM 총력전장비_스탯_{장비번호}
CATCH
	RETURN 0
ENDCATCH

; 스탯 변경, 체력 등은 나중에?
MAXBASE:대상:체력 += RESULT:추가스탯_최대체력 * 탈착
BASE:대상:체력 += RESULT:추가스탯_최대체력 * 탈착
MAXBASE:대상:기력 += RESULT:추가스탯_최대기력 * 탈착
BASE:대상:기력 += RESULT:추가스탯_최대기력 * 탈착
MAXBASE:대상:정신력 += RESULT:추가스탯_최대정신력 * 탈착
BASE:대상:정신력 += RESULT:추가스탯_최대정신력 * 탈착
ABL:대상:무투 += RESULT:추가스탯_무투 * 탈착
ABL:대상:방위 += RESULT:추가스탯_방위 * 탈착
ABL:대상:지략 += RESULT:추가스탯_지략 * 탈착
ABL:대상:정치 += RESULT:추가스탯_정치 * 탈착
ABL:대상:신비 += RESULT:추가스탯_신비 * 탈착
ABL:대상:가창 += RESULT:추가스탯_가창 * 탈착
ABL:대상:요리 += RESULT:추가스탯_요리 * 탈착

RETURN 1


