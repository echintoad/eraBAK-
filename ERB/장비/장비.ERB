; "스탯합"으로 받은 스탯 출력, RESULT 에 줄수 출력
@총력전_장비_스탯_출력_텍스트(스탯합, 너비)
#DIM REF 스탯합, 0
#DIM 너비
#DIM DYNAMIC Line_Num
; #DIM DYNAMIC 스탯합_수정, 24 ; 오류 방지?
#LOCALSIZE 1
#LOCALSSIZE 1

VARSET RESULT, 0
VARSET RESULTS, ""

; VARSIZE 스탯합
; PRINTFORM 스탯합 사이즈: {RESULT}
VARSIZE 스탯합
IF RESULT < 24
	; 아님 스탯합_수정 으로 고쳐버리기?
	THROW 받은 배열 크기가 맞지 않습니다 = {VARSIZE(스탯합)}
ENDIF

FOR LOCAL, 1, 24 ; 추가스탯_군중제어저항 + 1
	IF 스탯합:LOCAL > 0
		SELECTCASE LOCAL
			CASE 추가스탯_최대체력
				LOCALS = 체력: 
			CASE 추가스탯_최대기력
				LOCALS = 기력: 
			CASE 추가스탯_최대정신력
				LOCALS = 정신력: 
			CASE 추가스탯_무투
				LOCALS = 무투: 
			CASE 추가스탯_방위
				LOCALS = 방위: 
			CASE 추가스탯_지략
				LOCALS = 지략: 
			CASE 추가스탯_정치
				LOCALS = 정치: 
			CASE 추가스탯_신비
				LOCALS = 신비: 
			CASE 추가스탯_가창
				LOCALS = 가창: 
			CASE 추가스탯_요리
				LOCALS = 요리: 
			CASE 추가스탯_총력전체력
				LOCALS = 총력전HP: 
			CASE 추가스탯_공격력
				LOCALS = 공격력: 
			CASE 추가스탯_방어력
				LOCALS = 방어력: 
			CASE 추가스탯_명중률
				LOCALS = 명중률: 
			CASE 추가스탯_회피율
				LOCALS = 회피율: 
			CASE 추가스탯_치유력
				LOCALS = 치유력: 
			CASE 추가스탯_치명타
				LOCALS = 치명타: 
			CASE 추가스탯_치명타저항
				LOCALS = 치명저항: 
			CASE 추가스탯_치명대미지
				LOCALS = 치댐: 
			CASE 추가스탯_치명대미지저항
				LOCALS = 치댐저항: 
			CASE 추가스탯_군중제어한계
				LOCALS = CC: 
			CASE 추가스탯_군중제어강화
				LOCALS = CC강화: 
			CASE 추가스탯_군중제어저항
				LOCALS = CC저항: 
		ENDSELECT
		LOCALS += @"{스탯합:LOCAL}"
		; 다음 줄로 넘어가야될지 확인
		STRLENFORM %RESULTS:Line_Num%, %LOCALS%
		IF RESULT > 너비
			Line_Num ++
		ELSE
			STRLENFORM %RESULTS:Line_Num%
			IF RESULT != 0 ; && Line_Num != 0
				RESULTS:Line_Num += @", "
			ENDIF
		ENDIF
		RESULTS:Line_Num += @"%LOCALS%"
	ENDIF
NEXT
RETURN Line_Num + 1

@총력전_장비_착용(대상,장비번호,슬롯,탈착)
#DIM 대상
#DIM 탈착
#DIM 슬롯
#DIM 장비번호

IF 탈착 == 1
	IF 착용장비:대상:슬롯 >= 0
		; 장착중인 장비 탈착
		CALL _총력전_장비_스탯(대상, 착용장비:대상:슬롯, -1)
		장비:(착용장비:대상:슬롯) ++
	ENDIF
	; 장비 장착
	CALL _총력전_장비_스탯(대상, 장비번호, 1)
	착용장비:대상:슬롯 = 장비번호
	장비:장비번호 --
ELSEIF 탈착 == -1
	; 장비 탈착
	IF 착용장비:대상:슬롯 >= 0
		CALL _총력전_장비_스탯(대상, 착용장비:대상:슬롯, -1)
		착용장비:대상:슬롯 = -1
		장비:장비번호 ++
	ENDIF
ELSE
	; 추가 에러 메세지?
	RETURN
ENDIF

; 스탯 증가/감소
; @총력전_장비_착용 으로만 작동
; 임시: _UPDATE_000606_EQUIP_STATCHANGE 에서도 사용
@_총력전_장비_스탯(대상, 장비번호, 탈착)
#DIM 대상
#DIM 탈착
#DIM 슬롯
#DIM 장비번호

; RESULT 에 스탯 받기
TRYCCALLFORM 총력전장비_스탯_{장비번호}
CATCH
	RETURN 0
ENDCATCH

; 스탯 변경, 체력 등은 나중에?
MAXBASE:대상:체력 += RESULT:추가스탯_최대체력 * 탈착
BASE:대상:체력 += RESULT:추가스탯_최대체력 * 탈착
MAXBASE:대상:기력 += RESULT:추가스탯_최대기력 * 탈착
BASE:대상:기력 += RESULT:추가스탯_최대기력 * 탈착
MAXBASE:대상:정신력 += RESULT:추가스탯_최대정신력 * 탈착
BASE:대상:정신력 += RESULT:추가스탯_최대정신력 * 탈착
ABL:대상:무투 += RESULT:추가스탯_무투 * 탈착
ABL:대상:방위 += RESULT:추가스탯_방위 * 탈착
ABL:대상:지략 += RESULT:추가스탯_지략 * 탈착
ABL:대상:정치 += RESULT:추가스탯_정치 * 탈착
ABL:대상:신비 += RESULT:추가스탯_신비 * 탈착
ABL:대상:가창 += RESULT:추가스탯_가창 * 탈착
ABL:대상:요리 += RESULT:추가스탯_요리 * 탈착

RETURN 1


